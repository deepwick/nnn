# Deepwick colors for nnn (fish). Source this from config.fish.
# nnn takes 256-color indices only. 01-0f are your terminal's ANSI colors, so
# use a Deepwick terminal theme. Order: block char dir exe regular hardlink
# symlink details orphan fifo socket unknown.
set -gx NNN_COLORS '4444'
set -gx NNN_FCOLORS '0303040a000c0e08010b0d01'
